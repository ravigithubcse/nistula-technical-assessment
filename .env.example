# Nistula Unified Messaging Platform - Environment Variables
# Created by: Ravikumar
# Copy this file to .env and fill in your actual values

# =============================================================================
# CLAUDE API CONFIGURATION
# =============================================================================
# Your Anthropic Claude API key (required for AI-generated replies)
CLAUDE_API_KEY=your_claude_api_key_here

# Claude model to use for guest message responses
CLAUDE_MODEL=claude-sonnet-4-20250514

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application environment: development, staging, production
ENVIRONMENT=development

# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# PostgreSQL connection URL format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nistula_user:nistula_password@localhost:5432/nistula_db

# Individual database connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nistula_db
DB_USER=nistula_user
DB_PASSWORD=nistula_password
